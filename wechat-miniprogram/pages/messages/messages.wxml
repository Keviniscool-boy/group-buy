<view class="page">
  <view class="card msg {{item.is_read==0?'unread':''}}" wx:for="{{messages}}" wx:key="id" bindtap="readMsg" data-id="{{item.id}}">
    <view class="title">{{item.title}}</view>
    <view class="content">{{item.content}}</view>
    <view class="muted">{{item.created_at}}</view>
  </view>
  <view class="empty" wx:if="{{!messages.length}}">暂无消息</view>
</view>
