.hero {
  padding: 38rpx 28rpx 30rpx;
  background: linear-gradient(135deg, #ff6b35, #ff9f6e);
  color: #fff;
}
.title { font-size: 42rpx; font-weight: 800; }
.sub { margin-top: 8rpx; opacity: .9; }
.notice {
  padding: 16rpx 24rpx;
  color: #c85b00;
  background: #fff8e1;
  font-size: 24rpx;
}
.search {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
}
.search input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
}
.search button {
  width: 140rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #ff6b35;
  color: #fff;
  font-size: 26rpx;
}
.banner {
  height: 260rpx;
  margin: 20rpx 24rpx;
  border-radius: 18rpx;
  overflow: hidden;
}
.banner image { width: 100%; height: 100%; }
.banner-title {
  position: absolute;
  left: 28rpx;
  bottom: 24rpx;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,.35);
}
.cats {
  white-space: nowrap;
  padding: 10rpx 20rpx 20rpx;
  background: #fff;
}
.cat {
  display: inline-block;
  margin-right: 16rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  color: #666;
}
.cat.active {
  color: #fff;
  background: #ff6b35;
}
.section-title {
  padding: 28rpx 24rpx 14rpx;
  font-weight: 800;
  font-size: 32rpx;
}
.goods-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  padding: 0 24rpx;
}
.goods-card {
  overflow: hidden;
  border-radius: 18rpx;
  background: #fff;
}
.goods-card image {
  width: 100%;
  height: 260rpx;
}
.info { padding: 18rpx; }
.name {
  height: 40rpx;
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: 24rpx;
}
