.cover { width: 100%; height: 560rpx; background: #eee; }
.name { font-size: 38rpx; font-weight: 800; }
.price-line { display: flex; gap: 16rpx; align-items: center; margin: 18rpx 0; }
.desc { margin-top: 24rpx; line-height: 1.7; color: #555; }
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 18rpx;
  padding: 18rpx 24rpx 34rpx;
  background: #fff;
}
.footer button {
  flex: 1;
  border-radius: 999rpx;
  background: #fff1eb;
  color: #ff6b35;
}
.footer button.primary {
  background: #ff6b35;
  color: #fff;
}
